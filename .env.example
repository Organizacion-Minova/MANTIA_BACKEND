APP_NAME=MANTIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

# Dirección del frontend (enlaces de los correos)
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=Mantia_db
DB_USERNAME=postgres
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---- Correo SIN internet (Mailpit: bandeja local en http://localhost:8025) ----
# Si no tienes Mailpit, usa MAIL_MAILER=log y el correo queda en storage/logs/laravel.log
# Con internet (Gmail) cambia host, puerto 587, usuario y contraseña de aplicación.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=mantia@mantia.local
MAIL_FROM_NAME="MANTIA"

# Captcha local (funciona sin internet). Ponlo en false solo para pruebas.
CAPTCHA_ENABLED=true

# Clave interna de administración para backups posteriores a la primera copia (use un valor aleatorio y privado)
BACKUP_ADMIN_KEY=

# ---- IA: gemini (con internet) u ollama (local, sin internet) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Ruta del PHP de consola para el botón "Correr pruebas" (opcional; si se deja vacío se detecta solo)
TESTS_PHP_BINARY=
