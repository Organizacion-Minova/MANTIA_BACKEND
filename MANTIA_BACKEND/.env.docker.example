# Copia este archivo como .env.docker (en esta misma carpeta) y completa lo que dice CAMBIAR.

APP_NAME=MANTIA
APP_ENV=local
# CAMBIAR: genérala con  docker compose run --rm --no-deps backend php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Base de datos ----
# La contraseña va DOS veces (POSTGRES_PASSWORD la usa el contenedor de Postgres, DB_PASSWORD la usa Laravel).
# CAMBIAR: pon la misma contraseña en las dos. Si ya tenías el volumen creado, usa la contraseña con la que se creó.
POSTGRES_DB=Mantia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=Mantia_db
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_clave

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Correo: llega a Mailpit (http://localhost:8025), funciona sin internet ----
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=mantia@mantia.local
MAIL_FROM_NAME="MANTIA"

# Captcha local (no necesita internet)
CAPTCHA_ENABLED=true

# ---- IA ----
# gemini: necesita internet y GEMINI_API_KEY.
# ollama: IA local; instala Ollama en tu PC (no en Docker) y descarga el modelo: ollama pull qwen2.5:3b
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m

# CAMBIAR: clave interna para las acciones de backup posteriores a la primera copia (valor largo y privado)
BACKUP_ADMIN_KEY=
